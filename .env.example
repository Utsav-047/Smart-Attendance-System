# =================================================================
# Smart Attendance System - Environment Configuration Template
# Copy this file to .env and configure strong production secrets.
# NEVER commit your actual .env file with secrets into version control!
# =================================================================

# Flask Application Secret Key (generate using: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string

# Flask Runtime Environment (0 = Production, 1 = Development)
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Cookie Security (Set to 1 in production when serving behind HTTPS/TLS)
SESSION_COOKIE_SECURE=0

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=smart_attendance

# SMTP Email Alert Service (Optional: Google App Password for notifications)
EMAIL_ADDRESS=noreply-attendance@youruniversity.edu
EMAIL_PASSWORD=your_16_character_google_app_password

# Default Initial Administrator Credentials (seeded on first DB startup)
DEFAULT_ADMIN_EMAIL=admin@institution.edu
DEFAULT_ADMIN_PASSWORD=AdminPassphrase!2026

# Biometric & Pickle HMAC Salt (Optional: defaults to derived SECRET_KEY)
PICKLE_HMAC_KEY=optional_separate_hmac_signing_key_here

